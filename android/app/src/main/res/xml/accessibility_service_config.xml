<?xml version="1.0" encoding="utf-8"?>
<!--
  JARVIS accessibility is intentionally minimal.
  It can only perform global navigation actions (back / home / recents / notification shade).
  Notice the absence of flagRequestRetrieveInteractiveWindows, canRetrieveWindowContent,
  and any event type that would deliver on-screen text to this app.
  Activity content is never read, collected or stored.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_label"
    android:notificationTimeout="100" />
